{% load static %}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MotorTech Service{% endblock %}</title>
    <link rel="stylesheet" href="{% static 'taller/css/app.css' %}">
</head>
<body>
    <div class="app-layout">
        {% include "taller/components/sidebar.html" %}
        <main class="main-content">
            {% include "taller/components/navbar.html" %}
            <section class="page-content">
                {% if messages %}
                    {% for message in messages %}
                        <div class="notice">{{ message }}</div>
                    {% endfor %}
                {% endif %}
                {% block content %}{% endblock %}
            </section>
            <footer class="footer">© 2026 MotorTech Service · Gestión inteligente de taller</footer>
        </main>
    </div>
    <script src="{% static 'taller/js/app.js' %}"></script>
</body>
</html>
