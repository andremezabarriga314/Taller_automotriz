/* Componentes reutilizables de MotorTech Service */

.page-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 26px;
}

.page-heading h1 {
    margin: 5px 0;
}

.page-heading p {
    margin: 0;
    opacity: .7;
}

.page-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    opacity: .65;
}

.empty-state {
    padding: 48px 24px;
    text-align: center;
    border: 1px dashed rgba(255,255,255,.15);
    border-radius: 14px;
}

.empty-state-icon {
    font-size: 34px;
    margin-bottom: 12px;
}

.empty-state p {
    opacity: .7;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 24px;
}

/* =========================================================
   MOTORTECH SERVICE — REDISEÑO GLOBAL
   Capa visual para dashboard, CRUD y formularios
   ========================================================= */

:root {
    --mt-bg: #080d16;
    --mt-sidebar: #0b1220;
    --mt-surface: #111b2b;
    --mt-surface-2: #162337;
    --mt-border: rgba(148, 163, 184, .13);
    --mt-text: #edf3fb;
    --mt-muted: #8999ad;
    --mt-orange: #f97316;
    --mt-orange-light: #fb923c;
    --mt-radius: 17px;
    --mt-shadow: 0 18px 50px rgba(0, 0, 0, .20);
}

html {
    min-height: 100%;
    background: var(--mt-bg);
}

body {
    min-height: 100vh;
    margin: 0;
    color: var(--mt-text);
    background:
        radial-gradient(ellipse at 85% 0%, rgba(249, 115, 22, .075), transparent 32%),
        radial-gradient(ellipse at 10% 90%, rgba(37, 99, 235, .055), transparent 30%),
        var(--mt-bg);
    font-family: Inter, "Segoe UI", sans-serif;
    font-size: 14px;
}

.app-layout {
    min-height: 100vh;
    background: transparent;
}

/* MENÚ LATERAL */

.sidebar {
    width: 255px;
    padding: 25px 17px 20px;
    background: linear-gradient(180deg, #0e1828 0%, #0a111d 100%);
    border-right: 1px solid var(--mt-border);
    box-shadow: 12px 0 40px rgba(0, 0, 0, .12);
}

.brand {
    min-height: 65px;
    margin-bottom: 28px;
    padding: 5px 10px 23px;
    border-bottom: 1px solid var(--mt-border);
}

.brand-icon {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: linear-gradient(135deg, #fb923c, #ea580c);
    box-shadow: 0 8px 25px rgba(249, 115, 22, .25);
}

.brand strong {
    color: #f8fafc;
    font-size: 15px;
    letter-spacing: 1.5px;
}

.brand small {
    margin-top: 4px;
    color: #8191a7;
    font-size: 9px;
    letter-spacing: 2px;
}

.menu-label {
    margin: 23px 10px 10px;
    color: #687b93;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.7px;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 43px;
    margin: 4px 0;
    padding: 0 12px;
    color: #9eacc0;
    border: 1px solid transparent;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 600;
    transition: .2s ease;
}

.nav-link > span {
    display: inline-grid;
    width: 23px;
    height: 23px;
    place-items: center;
    color: #a7b6c9;
    font-size: 17px;
}

.nav-link:hover {
    color: #fff;
    background: rgba(255, 255, 255, .055);
    border-color: var(--mt-border);
    transform: translateX(2px);
}

.nav-link.active {
    color: #fff;
    background: linear-gradient(100deg, rgba(249, 115, 22, .19), rgba(249, 115, 22, .055));
    border-color: rgba(249, 115, 22, .23);
    box-shadow: inset 3px 0 #f97316;
}

.nav-link.active > span {
    color: #fb923c;
}

.sidebar-bottom {
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--mt-border);
}

.system-status {
    color: #9aabc0;
    font-size: 11px;
}

.system-status span,
.mt-live-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 12px rgba(34, 197, 94, .6);
}

.logout-button {
    width: 100%;
    margin-top: 13px;
    padding: 11px 12px;
    color: #fca5a5;
    background: rgba(239, 68, 68, .07);
    border: 1px solid rgba(239, 68, 68, .13);
    border-radius: 10px;
    cursor: pointer;
    transition: .2s ease;
}

.logout-button:hover {
    background: rgba(239, 68, 68, .15);
}

/* ÁREA PRINCIPAL */

.main-content {
    min-width: 0;
    min-height: 100vh;
    margin-left: 255px;
    background: transparent;
}

.page-content {
    width: min(100%, 1600px);
    min-height: calc(100vh - 125px);
    margin: 0 auto;
    padding: 32px 38px 45px;
    box-sizing: border-box;
}

.footer {
    padding: 20px 38px;
    color: #64748b;
    border-top: 1px solid var(--mt-border);
    font-size: 10px;
    letter-spacing: .5px;
}

/* BARRA SUPERIOR */

.navbar,
.topbar,
.top-navbar {
    min-height: 66px;
    padding: 0 38px;
    background: rgba(11, 18, 32, .86);
    border-bottom: 1px solid var(--mt-border);
    backdrop-filter: blur(18px);
}

/* DASHBOARD */

.mt-dashboard {
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
}

.mt-hero {
    position: relative;
    min-height: 255px;
    overflow: hidden;
    padding: 38px 42px;
    color: #fff;
    background:
        radial-gradient(circle at 85% 20%, rgba(251, 146, 60, .23), transparent 28%),
        linear-gradient(115deg, #18283e 0%, #111d30 54%, #202235 100%);
    border: 1px solid rgba(255, 255, 255, .10);
    border-radius: 22px;
    box-shadow: var(--mt-shadow);
    box-sizing: border-box;
}

.mt-hero::before {
    content: "";
    position: absolute;
    width: 330px;
    height: 330px;
    right: 8%;
    top: -190px;
    border: 1px solid rgba(251, 146, 60, .25);
    border-radius: 50%;
    box-shadow: 0 0 0 35px rgba(251, 146, 60, .025),
                0 0 0 70px rgba(251, 146, 60, .02);
}

.mt-hero h1 {
    max-width: 650px;
    margin: 15px 0 10px;
    color: #fff;
    font-family: "Space Grotesk", Inter, sans-serif;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -1.8px;
}

.mt-hero p {
    max-width: 540px;
    color: #aebbd0;
    font-size: 13px;
    line-height: 1.8;
}

.mt-overline {
    color: #fb995d;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 2px;
}

.mt-hero-caption {
    color: #a9b7c9;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 2px;
}

.mt-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin: 34px 0 17px;
}

.mt-section-heading h2 {
    margin: 5px 0 0;
    color: #f1f5f9;
    font-family: "Space Grotesk", sans-serif;
    font-size: 22px;
    letter-spacing: -.5px;
}

.mt-section-note {
    color: var(--mt-muted);
    font-size: 11px;
}

.mt-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
}

.mt-stat-card {
    position: relative;
    display: flex;
    min-height: 145px;
    flex-direction: column;
    justify-content: space-between;
    padding: 19px;
    overflow: hidden;
    color: var(--mt-text);
    background: linear-gradient(145deg, #152237, #101a2a);
    border: 1px solid var(--mt-border);
    border-radius: var(--mt-radius);
    box-shadow: 0 8px 24px rgba(0, 0, 0, .10);
    transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
    box-sizing: border-box;
}

.mt-stat-card:hover {
    transform: translateY(-4px);
    border-color: rgba(249, 115, 22, .38);
    box-shadow: 0 16px 35px rgba(0, 0, 0, .22);
}

.mt-stat-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #93a4ba;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.2px;
}

.mt-stat-icon {
    display: grid;
    width: 37px;
    height: 37px;
    place-items: center;
    color: #fb995d;
    background: rgba(249, 115, 22, .11);
    border: 1px solid rgba(249, 115, 22, .16);
    border-radius: 11px;
    font-size: 19px;
}

.mt-stat-card > strong {
    margin-top: 10px;
    color: #fff;
    font-family: "Space Grotesk", sans-serif;
    font-size: 32px;
    line-height: 1.1;
}

.mt-stat-card > small {
    color: #8192a8;
    font-size: 10px;
}

.mt-stat-footer {
    display: flex;
    justify-content: space-between;
    margin-top: 15px;
    padding-top: 11px;
    color: #f9a06a;
    border-top: 1px solid var(--mt-border);
    font-size: 10px;
    font-weight: 700;
}

/* PANELES Y TABLAS */

.mt-panel,
.panel,
.content-card,
.card {
    color: var(--mt-text);
    background: linear-gradient(145deg, #131f31, #101a29);
    border: 1px solid var(--mt-border);
    border-radius: var(--mt-radius);
    box-shadow: 0 10px 30px rgba(0, 0, 0, .12);
}

.mt-panel {
    margin-top: 20px;
    padding: 23px;
}

.mt-panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 20px;
}

.mt-panel-heading h3 {
    margin: 5px 0;
    color: #f1f5f9;
    font-family: "Space Grotesk", sans-serif;
    font-size: 18px;
}

.mt-panel-heading p {
    margin: 0;
    color: var(--mt-muted);
    font-size: 11px;
}

.mt-view-link,
.mt-inventory-link {
    color: #fb995d;
    font-size: 11px;
    font-weight: 700;
}

.mt-table-wrap,
.table-responsive {
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--mt-border);
    border-radius: 12px;
}

.mt-table,
table {
    width: 100%;
    border-collapse: collapse;
}

.mt-table {
    min-width: 650px;
}

.mt-table th,
table th {
    padding: 13px 15px;
    color: #8193aa;
    background: rgba(255, 255, 255, .025);
    border-bottom: 1px solid var(--mt-border);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .8px;
    text-align: left;
    white-space: nowrap;
}

.mt-table td,
table td {
    padding: 14px 15px;
    color: #c6d1df;
    border-bottom: 1px solid rgba(148, 163, 184, .09);
    font-size: 11px;
}

.mt-table tbody tr,
table tbody tr {
    transition: background .18s ease;
}

.mt-table tbody tr:hover,
table tbody tr:hover {
    background: rgba(255, 255, 255, .035);
}

.mt-table tbody tr:last-child td,
table tbody tr:last-child td {
    border-bottom: 0;
}

.mt-order-number {
    color: #fb995d;
}

.mt-status {
    display: inline-flex;
    padding: 5px 9px;
    color: #fdc48d;
    background: rgba(249, 115, 22, .10);
    border: 1px solid rgba(249, 115, 22, .16);
    border-radius: 30px;
    font-size: 9px;
    font-weight: 700;
}

/* INVENTARIO */

.mt-stock-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 13px 0 8px;
}

.mt-stock-info strong {
    display: block;
    color: #e5edf7;
    font-size: 11px;
}

.mt-stock-info small,
.mt-stock-label {
    color: #8192a8;
    font-size: 9px;
}

.mt-stock-value {
    color: #fb995d;
    font-size: 13px;
    font-weight: 800;
}

.mt-stock-track {
    height: 5px;
    overflow: hidden;
    background: #263449;
    border-radius: 10px;
}

.mt-stock-track span {
    display: block;
    width: 35%;
    height: 100%;
    background: linear-gradient(90deg, #f97316, #fb923c);
    border-radius: inherit;
}

.mt-stock-label {
    margin-top: 7px;
}

/* ESTADOS VACÍOS */

.mt-empty {
    display: flex;
    min-height: 170px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 22px;
    color: #a7b5c7;
    text-align: center;
}

.mt-empty-icon {
    display: grid;
    width: 42px;
    height: 42px;
    margin-bottom: 12px;
    place-items: center;
    color: #fb995d;
    background: rgba(249, 115, 22, .10);
    border-radius: 13px;
    font-size: 20px;
}

.mt-empty strong {
    color: #e7edf5;
    font-size: 12px;
}

.mt-empty p {
    color: #8192a8;
    font-size: 10px;
}

/* CRUD: LISTADOS, FORMULARIOS Y ACCIONES */

.page-header,
.module-header,
.crud-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 25px;
}

.page-header h1,
.module-header h1,
.crud-header h1,
.page-title {
    color: #f1f5f9;
    font-family: "Space Grotesk", sans-serif;
    font-size: 27px;
    font-weight: 700;
}

.page-header p,
.module-header p,
.crud-header p {
    color: var(--mt-muted);
    font-size: 12px;
}

button,
.btn,
.button,
input[type="submit"] {
    transition: .2s ease;
}

.btn-primary,
button.btn-primary,
button[type="submit"],
input[type="submit"] {
    color: #fff;
    background: linear-gradient(135deg, #f97316, #ea580c);
    border: 1px solid rgba(251, 146, 60, .35);
    border-radius: 10px;
    font-weight: 700;
}

.btn-primary:hover,
button.btn-primary:hover,
button[type="submit"]:hover,
input[type="submit"]:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
}

input:not([type="checkbox"]):not([type="radio"]),
select,
textarea {
    width: 100%;
    min-height: 42px;
    padding: 10px 12px;
    color: #e7edf5;
    background: #0b1524;
    border: 1px solid #2a3a50;
    border-radius: 9px;
    outline: none;
    box-sizing: border-box;
}

input:focus,
select:focus,
textarea:focus {
    border-color: #f97316;
    box-shadow: 0 0 0 3px rgba(249, 115, 22, .10);
}

select option {
    color: #e7edf5;
    background: #111b2b;
}

label {
    display: block;
    margin-bottom: 7px;
    color: #b9c6d6;
    font-size: 11px;
    font-weight: 700;
}

form p {
    color: #aab8ca;
}

.helptext {
    display: block;
    margin-top: 5px;
    color: #8192a8;
    font-size: 10px;
}

.errorlist,
.error-message {
    color: #fca5a5;
    font-size: 11px;
}

.notice,
.alert {
    margin-bottom: 15px;
    padding: 12px 15px;
    color: #dbeafe;
    background: rgba(37, 99, 235, .10);
    border: 1px solid rgba(59, 130, 246, .20);
    border-radius: 10px;
    font-size: 12px;
}

.mt-dashboard-footer {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 23px 3px 8px;
    color: #74859a;
    font-size: 9px;
    letter-spacing: .6px;
}

.mt-dashboard-footer b {
    color: #ff895b;
    padding: 0 4px;
}

/* RESPONSIVE */

@media (max-width: 1100px) {
    .mt-stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .page-content {
        padding: 26px 24px 35px;
    }
}

@media (max-width: 760px) {
    .sidebar {
        width: 235px;
        transform: translateX(-100%);
        transition: transform .25s ease;
    }

    .sidebar.open,
    .sidebar.active {
        transform: translateX(0);
    }

    .main-content {
        margin-left: 0;
    }

    .page-content {
        padding: 20px 15px 30px;
    }

    .mt-hero {
        min-height: 230px;
        padding: 27px 22px;
    }

    .mt-hero h1 {
        font-size: 31px;
    }

    .mt-stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .mt-stat-card {
        min-height: 135px;
        padding: 14px;
    }

    .mt-stat-card > strong {
        font-size: 27px;
    }

    .mt-panel {
        padding: 16px;
    }

    .mt-section-heading,
    .mt-panel-heading,
    .page-header,
    .module-header,
    .crud-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .mt-dashboard-footer {
        flex-direction: column;
    }
}

@media (max-width: 420px) {
    .mt-stats-grid {
        grid-template-columns: 1fr;
    }

    .mt-stat-card {
        min-height: 125px;
    }
}

/* =====================================================
   MOTORTECH — PREMIUM VISUAL REFINEMENT
   ===================================================== */

:root {
    --mt-orange: #ff762b;
    --mt-orange-soft: rgba(255, 118, 43, .12);
    --mt-line: rgba(148, 163, 184, .11);
    --mt-card: #111c2d;
    --mt-card-light: #17253a;
}

/* FONDO Y SUPERFICIES */

body {
    background:
        radial-gradient(ellipse at 75% 0%, rgba(255, 118, 43, .055), transparent 35%),
        #080e18 !important;
    color: #e9eff8;
}

.page-content {
    padding-top: 36px;
}

.mt-dashboard {
    max-width: 1450px;
}

/* HERO PRINCIPAL */

.mt-hero {
    position: relative;
    isolation: isolate;
    min-height: 280px;
    padding: 43px 45px;
    background:
        linear-gradient(105deg, #18283d 0%, #111d30 48%, #1c2434 100%);
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 24px;
    box-shadow: 0 24px 65px rgba(0,0,0,.27);
}

.mt-hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    width: 390px;
    height: 390px;
    top: -235px;
    right: 10%;
    border: 1px solid rgba(255, 133, 69, .24);
    border-radius: 50%;
    box-shadow:
        0 0 0 35px rgba(255, 133, 69, .025),
        0 0 0 75px rgba(255, 133, 69, .018),
        0 0 0 115px rgba(255, 133, 69, .012);
}

.mt-hero::after {
    content: "";
    position: absolute;
    z-index: -1;
    width: 240px;
    height: 240px;
    right: 13%;
    bottom: -190px;
    background: rgba(255, 118, 43, .12);
    filter: blur(75px);
    border-radius: 50%;
}

.mt-hero h1 {
    max-width: 620px;
    font-size: clamp(34px, 4vw, 48px);
    letter-spacing: -2px;
    line-height: 1.08;
}

.mt-hero p {
    max-width: 490px;
    color: #a9b8ca;
    font-size: 13px;
    line-height: 1.9;
}

.mt-hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    color: #ffb17f;
    background: rgba(255, 118, 43, .09);
    border: 1px solid rgba(255, 118, 43, .2);
    border-radius: 30px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.4px;
}

.mt-hero-visual {
    opacity: .95;
    filter: drop-shadow(0 18px 30px rgba(0,0,0,.25));
}

.mt-hero-caption {
    color: #a9b9cc;
    font-size: 9px;
    line-height: 1.8;
    letter-spacing: 2px;
}

/* ACCIONES DEL HERO */

.mt-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 11px;
    margin-top: 25px;
}

.mt-hero-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 17px;
    color: #fff;
    background: linear-gradient(135deg, #ff843d, #e95d17);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 10px;
    font-size: 11px;
    font-weight: 800;
    box-shadow: 0 7px 20px rgba(249, 115, 22, .16);
    transition: .22s ease;
}

.mt-hero-actions a:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 25px rgba(249, 115, 22, .25);
}

.mt-hero-actions a:nth-child(n+2) {
    color: #d9e3ef;
    background: rgba(255,255,255,.055);
    border-color: rgba(255,255,255,.12);
    box-shadow: none;
}

/* ENCABEZADOS DE SECCIÓN */

.mt-section-heading {
    margin-top: 39px;
    margin-bottom: 20px;
}

.mt-section-heading h2 {
    font-size: 23px;
    letter-spacing: -.8px;
}

.mt-overline {
    color: #ff995d;
    letter-spacing: 2px;
}

.mt-section-note {
    padding: 8px 12px;
    color: #8d9db1;
    background: rgba(255,255,255,.025);
    border: 1px solid var(--mt-line);
    border-radius: 8px;
    font-size: 10px;
}

/* TARJETAS DE INDICADORES */

.mt-stats-grid {
    gap: 17px;
}

.mt-stat-card {
    min-height: 158px;
    padding: 21px;
    background:
        linear-gradient(145deg, rgba(24, 39, 59, .98), rgba(15, 25, 40, .98));
    border: 1px solid rgba(148, 163, 184, .12);
    border-radius: 17px;
    box-shadow: 0 12px 30px rgba(0,0,0,.12);
}

.mt-stat-card::after {
    content: "";
    position: absolute;
    width: 100px;
    height: 100px;
    right: -45px;
    bottom: -55px;
    background: rgba(255, 118, 43, .07);
    filter: blur(25px);
    border-radius: 50%;
    pointer-events: none;
}

.mt-stat-card:hover {
    background: linear-gradient(145deg, #1b2b42, #142238);
    border-color: rgba(255, 132, 61, .35);
    transform: translateY(-4px);
}

.mt-stat-top {
    color: #9baec3;
    font-size: 9px;
    letter-spacing: 1.5px;
}

.mt-stat-icon {
    width: 40px;
    height: 40px;
    color: #ff995d;
    background: rgba(255, 118, 43, .10);
    border: 1px solid rgba(255, 118, 43, .18);
    border-radius: 12px;
}

.mt-stat-card > strong {
    margin-top: 13px;
    font-size: 35px;
    letter-spacing: -1.5px;
}

.mt-stat-card > small {
    margin-top: 4px;
    color: #8294aa;
    font-size: 10px;
}

.mt-stat-footer {
    color: #ff995d;
    border-color: rgba(148, 163, 184, .12);
}

/* PANELES */

.mt-panel {
    padding: 25px;
    background: linear-gradient(145deg, #121e30, #0f1928);
    border: 1px solid rgba(148, 163, 184, .12);
    border-radius: 18px;
    box-shadow: 0 15px 35px rgba(0,0,0,.13);
}

.mt-panel-heading {
    margin-bottom: 22px;
}

.mt-panel-heading h3 {
    font-size: 19px;
    letter-spacing: -.4px;
}

.mt-panel-heading p {
    margin-top: 5px;
    color: #8799af;
    font-size: 11px;
}

.mt-view-link {
    padding: 9px 12px;
    color: #ff995d;
    background: rgba(255, 118, 43, .07);
    border: 1px solid rgba(255, 118, 43, .15);
    border-radius: 9px;
    transition: .2s ease;
}

.mt-view-link:hover {
    background: rgba(255, 118, 43, .15);
}

/* TABLAS */

.mt-table-wrap {
    border: 1px solid rgba(148, 163, 184, .12);
    border-radius: 13px;
}

.mt-table {
    min-width: 680px;
}

.mt-table th {
    padding: 15px 17px;
    color: #8da0b7;
    background: #111c2c;
    font-size: 9px;
    letter-spacing: 1px;
}

.mt-table td {
    padding: 16px 17px;
    color: #cbd5e1;
    font-size: 11px;
}

.mt-table tbody tr:hover {
    background: rgba(255,255,255,.025);
}

.mt-order-number {
    color: #ff9a60;
    font-weight: 800;
}

.mt-status {
    padding: 6px 10px;
    color: #ffc08e;
    background: rgba(249, 115, 22, .10);
    border: 1px solid rgba(249, 115, 22, .18);
    border-radius: 7px;
}

/* INVENTARIO */

.mt-stock-info {
    padding: 11px 0;
    border-bottom: 1px solid rgba(148, 163, 184, .08);
}

.mt-stock-info strong {
    font-size: 12px;
}

.mt-stock-value {
    color: #ff995d;
    font-family: "Space Grotesk", sans-serif;
    font-size: 15px;
}

.mt-stock-track {
    height: 6px;
    background: #26364b;
}

.mt-stock-track span {
    background: linear-gradient(90deg, #ea580c, #ffad70);
    box-shadow: 0 0 12px rgba(249, 115, 22, .25);
}

/* ESTADOS VACÍOS */

.mt-empty {
    min-height: 190px;
}

.mt-empty-icon {
    width: 48px;
    height: 48px;
    color: #ff995d;
    background: rgba(255, 118, 43, .09);
    border: 1px solid rgba(255, 118, 43, .15);
    border-radius: 15px;
}

.mt-empty strong {
    font-size: 13px;
}

.mt-empty p {
    max-width: 330px;
    line-height: 1.7;
}

/* FOOTER */

.mt-dashboard-footer {
    margin-top: 10px;
    padding: 25px 4px 10px;
    border-top: 1px solid rgba(148, 163, 184, .10);
    font-size: 9px;
}

/* MOVIMIENTO REDUCIDO */

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
    }
}

@media (max-width: 760px) {
    .mt-hero {
        padding: 28px 23px;
    }

    .mt-hero-visual {
        opacity: .2;
    }

    .mt-panel {
        padding: 17px;
    }

    .mt-section-note {
        display: none;
    }
}


/* =====================================================
   MOTORTECH — SISTEMA PROFESIONAL DE BOTONES
   ===================================================== */

:root {
    --mt-btn-primary: #2563eb;
    --mt-btn-primary-hover: #1d4ed8;
    --mt-btn-danger: #dc3545;
    --mt-btn-danger-hover: #b91c1c;
    --mt-btn-success: #059669;
    --mt-btn-surface: #182438;
    --mt-btn-border: #33445d;
}

/* Base */
button,
input[type="submit"],
input[type="button"],
.btn,
a.btn,
.action-button,
.icon-button {
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .15px;
    border-radius: 9px;
    min-height: 39px;
    padding: 10px 17px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    text-decoration: none;
    transition: background .2s ease, border-color .2s ease,
                box-shadow .2s ease, transform .2s ease;
    outline: none;
}

/* Principal */
.btn-primary,
button[type="submit"],
input[type="submit"],
button.primary,
a.btn-primary {
    color: #fff !important;
    background: linear-gradient(135deg, #3478f6, #1d4ed8) !important;
    border: 1px solid #4385ff !important;
    box-shadow: 0 4px 12px rgba(37, 99, 235, .22);
}

.btn-primary:hover,
button[type="submit"]:hover,
input[type="submit"]:hover,
button.primary:hover,
a.btn-primary:hover {
    background: linear-gradient(135deg, #4385ff, #2563eb) !important;
    box-shadow: 0 7px 19px rgba(37, 99, 235, .34);
    transform: translateY(-2px);
}

/* Secundario */
.btn-secondary,
.btn-outline,
button.secondary,
a.btn-secondary {
    color: #d5dfed !important;
    background: #182438 !important;
    border: 1px solid #354761 !important;
}

.btn-secondary:hover,
.btn-outline:hover,
button.secondary:hover,
a.btn-secondary:hover {
    color: #fff !important;
    background: #263750 !important;
    border-color: #5a7397 !important;
    transform: translateY(-2px);
}

/* Eliminar */
.btn-danger,
button.danger,
a.btn-danger,
.btn-delete {
    color: #fff !important;
    background: linear-gradient(135deg, #e34855, #b91c1c) !important;
    border: 1px solid #f05b67 !important;
    box-shadow: 0 4px 12px rgba(220, 53, 69, .18);
}

.btn-danger:hover,
button.danger:hover,
a.btn-danger:hover,
.btn-delete:hover {
    background: #991b1b !important;
    box-shadow: 0 6px 16px rgba(220, 53, 69, .3);
    transform: translateY(-2px);
}

/* Guardar / confirmar */
.btn-success,
button.success,
a.btn-success {
    color: #fff !important;
    background: linear-gradient(135deg, #10a779, #047857) !important;
    border: 1px solid #20bd91 !important;
}

.btn-success:hover,
button.success:hover,
a.btn-success:hover {
    background: #047857 !important;
    transform: translateY(-2px);
}

/* Advertencia */
.btn-warning,
button.warning,
a.btn-warning {
    color: #201706 !important;
    background: #f4bd4f !important;
    border: 1px solid #ffd477 !important;
}

.btn-warning:hover,
button.warning:hover,
a.btn-warning:hover {
    background: #ffd477 !important;
    transform: translateY(-2px);
}

/* Acciones pequeñas de tablas */
.table .btn,
table .btn,
.table-actions .btn,
.actions .btn,
.action-button {
    min-height: 32px;
    padding: 7px 11px;
    font-size: 12px;
    border-radius: 7px;
}

/* Botones de icono */
.icon-button {
    width: 36px;
    min-width: 36px;
    height: 36px;
    min-height: 36px;
    padding: 0;
    color: #c8d7eb;
    background: #182438;
    border: 1px solid #354761;
}

.icon-button:hover {
    color: #fff;
    background: #2a3d59;
    border-color: #6284b5;
}

/* Todos los botones: interacción */
button:active,
.btn:active,
input[type="submit"]:active,
.action-button:active {
    transform: translateY(0) scale(.97);
}

button:focus-visible,
.btn:focus-visible,
input[type="submit"]:focus-visible {
    outline: 3px solid rgba(59, 130, 246, .35);
    outline-offset: 3px;
}

button:disabled,
.btn:disabled {
    opacity: .45;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}

/* Cancelar y volver */
.btn-cancel,
.btn-back {
    color: #cbd5e1 !important;
    background: transparent !important;
    border: 1px solid #394b64 !important;
}

.btn-cancel:hover,
.btn-back:hover {
    background: #1c2a3e !important;
    color: white !important;
}

/* Formularios */
.form-actions,
.form-buttons,
.button-group {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 22px;
}

/* Móvil */
@media (max-width: 600px) {
    .form-actions,
    .form-buttons,
    .button-group {
        width: 100%;
    }

    .form-actions .btn,
    .form-buttons .btn,
    .button-group .btn {
        flex: 1;
    }
}

/* ==========================================
   MOTORTECH SERVICE — BOTONES CRUD V2
   ========================================== */

/* Botón principal: Nuevo / Guardar */
a.primary-button,
button.primary-button,
.primary-button {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 9px !important;
    min-height: 43px !important;
    padding: 0 21px !important;
    border: 1px solid #4385ff !important;
    border-radius: 9px !important;
    background: linear-gradient(135deg, #3478f6, #1d4ed8) !important;
    color: #ffffff !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    letter-spacing: .2px !important;
    text-decoration: none !important;
    box-shadow: 0 5px 15px rgba(37, 99, 235, .24) !important;
    cursor: pointer !important;
    transition: all .2s ease !important;
}

a.primary-button:hover,
button.primary-button:hover,
.primary-button:hover {
    background: linear-gradient(135deg, #4b8cff, #2563eb) !important;
    border-color: #75a7ff !important;
    color: #fff !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 22px rgba(37, 99, 235, .36) !important;
}

/* Cancelar */
a.secondary-button,
button.secondary-button,
.secondary-button {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-height: 43px !important;
    padding: 0 19px !important;
    border: 1px solid #40516b !important;
    border-radius: 9px !important;
    background: #172337 !important;
    color: #d5dfed !important;
    font-size: 13px !important;
    font-weight: 650 !important;
    text-decoration: none !important;
    cursor: pointer !important;
    transition: all .2s ease !important;
}

a.secondary-button:hover,
button.secondary-button:hover,
.secondary-button:hover {
    background: #263750 !important;
    border-color: #6a83a6 !important;
    color: #fff !important;
    transform: translateY(-2px) !important;
}

/* Contenedor de acciones */
.row-actions {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    flex-wrap: wrap !important;
    gap: 8px !important;
}

/* Editar */
.row-actions a.action-edit,
a.action-edit {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-width: 76px !important;
    min-height: 33px !important;
    padding: 0 12px !important;
    border: 1px solid #315d91 !important;
    border-radius: 7px !important;
    background: rgba(37, 99, 235, .13) !important;
    color: #78b5ff !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    text-decoration: none !important;
    transition: all .2s ease !important;
}

.row-actions a.action-edit:hover,
a.action-edit:hover {
    background: #2563eb !important;
    border-color: #4c8fff !important;
    color: #fff !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 4px 12px rgba(37, 99, 235, .25) !important;
}

/* Eliminar */
.row-actions a.action-delete,
a.action-delete {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-width: 83px !important;
    min-height: 33px !important;
    padding: 0 12px !important;
    border: 1px solid #843b49 !important;
    border-radius: 7px !important;
    background: rgba(220, 53, 69, .12) !important;
    color: #ff8994 !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    text-decoration: none !important;
    transition: all .2s ease !important;
}

.row-actions a.action-delete:hover,
a.action-delete:hover {
    background: #c52d40 !important;
    border-color: #f06473 !important;
    color: #fff !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 4px 12px rgba(220, 53, 69, .25) !important;
}

/* Alineación de botones del formulario */
.form-actions {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 12px !important;
    padding-top: 20px !important;
    margin-top: 24px !important;
    border-top: 1px solid rgba(120, 145, 175, .15) !important;
}

/* Responsive */
@media (max-width: 600px) {
    .row-actions {
        gap: 6px !important;
    }

    .form-actions {
        flex-direction: column-reverse !important;
        align-items: stretch !important;
    }

    .form-actions > * {
        width: 100% !important;
    }
}
