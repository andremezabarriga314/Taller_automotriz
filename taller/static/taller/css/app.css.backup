@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');

:root {
    --bg: #0a0e16;
    --surface: #101722;
    --surface-2: #151f2d;
    --surface-3: #1b293a;
    --border: rgba(148, 163, 184, .13);
    --text: #edf3fa;
    --muted: #8b9aab;
    --primary: #f97316;
    --primary-hover: #ea580c;
    --blue: #38bdf8;
    --green: #22c55e;
    --red: #ef4444;
    --yellow: #eab308;
    --sidebar-width: 260px;
    --radius: 13px;
}

* {
    box-sizing: border-box;
}

html {
    min-height: 100%;
    background: var(--bg);
}

body {
    margin: 0;
    min-height: 100vh;
    background:
        radial-gradient(ellipse at 80% 0%, rgba(249,115,22,.055), transparent 35%),
        var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

button, input, select, textarea {
    font: inherit;
}

.app-layout {
    min-height: 100vh;
}

/* SIDEBAR */

.sidebar {
    position: fixed;
    z-index: 100;
    inset: 0 auto 0 0;
    width: var(--sidebar-width);
    display: flex;
    flex-direction: column;
    padding: 25px 17px;
    background: #0d141f;
    border-right: 1px solid var(--border);
    overflow-y: auto;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 5px 9px 29px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 26px;
}

.brand-icon {
    width: 43px;
    height: 43px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: linear-gradient(135deg, #fb923c, #ea580c);
    color: white;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 22px;
    font-weight: 800;
    box-shadow: 0 7px 25px rgba(249,115,22,.22);
}

.brand strong {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px;
    letter-spacing: 1.1px;
}

.brand small {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 2px;
}

.menu-label {
    margin: 20px 10px 9px;
    color: #657488;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 13px;
    min-height: 44px;
    margin: 3px 0;
    padding: 0 13px;
    border: 1px solid transparent;
    border-radius: 9px;
    color: #9eacbd;
    font-weight: 500;
    transition: .2s ease;
}

.nav-link span {
    width: 22px;
    color: #7f91a6;
    text-align: center;
    font-size: 17px;
}

.nav-link:hover {
    color: white;
    background: rgba(255,255,255,.045);
}

.nav-link.active {
    color: white;
    background: linear-gradient(90deg, rgba(249,115,22,.18), rgba(249,115,22,.045));
    border-color: rgba(249,115,22,.18);
}

.nav-link.active span {
    color: var(--primary);
}

.sidebar-bottom {
    margin-top: auto;
    padding-top: 22px;
    border-top: 1px solid var(--border);
}

.system-status {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 11px;
    margin-bottom: 12px;
    color: #a8b6c6;
    font-size: 12px;
}

.system-status span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 12px rgba(34,197,94,.6);
}

.logout-button {
    width: 100%;
    padding: 12px;
    color: #fca5a5;
    background: rgba(239,68,68,.07);
    border: 1px solid rgba(239,68,68,.12);
    border-radius: 9px;
    cursor: pointer;
    text-align: left;
    transition: .2s;
}

.logout-button:hover {
    background: rgba(239,68,68,.15);
}

/* CONTENIDO */

.main-content {
    min-height: 100vh;
    margin-left: var(--sidebar-width);
}

.navbar {
    position: sticky;
    z-index: 50;
    top: 0;
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 34px;
    background: rgba(10,14,22,.88);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(16px);
}

.page-content {
    width: 100%;
    max-width: 1700px;
    min-height: calc(100vh - 130px);
    margin: auto;
    padding: 32px 35px 45px;
}

.footer {
    padding: 20px 35px;
    color: #657488;
    border-top: 1px solid var(--border);
    font-size: 11px;
}

/* TITULOS */

h1, h2, h3, h4 {
    color: var(--text);
    font-family: 'Space Grotesk', sans-serif;
    line-height: 1.3;
}

h1 {
    margin: 0 0 9px;
    font-size: clamp(25px, 3vw, 34px);
    font-weight: 700;
    letter-spacing: -.8px;
}

h2 {
    font-size: 20px;
}

h3 {
    font-size: 16px;
}

p {
    color: var(--muted);
}

.page-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 27px;
}

.page-heading h1 {
    margin: 5px 0;
}

.page-heading p {
    margin: 0;
}

.page-eyebrow {
    color: var(--primary);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.8px;
}

/* TARJETAS */

.card, .panel, .stat-card, .dashboard-card {
    background: linear-gradient(145deg, #141e2b, #101722);
    border: 1px solid var(--border);
    border-radius: var(--radius);
}

.card, .panel {
    padding: 22px;
}

.stat-grid, .stats-grid, .dashboard-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 17px;
    margin-bottom: 25px;
}

.stat-card {
    position: relative;
    overflow: hidden;
    padding: 21px;
    transition: transform .2s, border-color .2s;
}

.stat-card:hover {
    transform: translateY(-3px);
    border-color: rgba(249,115,22,.35);
}

.stat-card h3 {
    margin: 0 0 12px;
    color: var(--muted);
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
}

.stat-card .stat-value,
.stat-card strong {
    display: block;
    color: white;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 30px;
    font-weight: 700;
}

/* TABLAS */

.table-container, .table-responsive {
    width: 100%;
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
}

table {
    width: 100%;
    border-collapse: collapse;
    white-space: nowrap;
}

thead {
    background: #172231;
}

th {
    padding: 15px 17px;
    color: #91a2b5;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .9px;
    text-align: left;
    text-transform: uppercase;
}

td {
    padding: 14px 17px;
    color: #cbd5e1;
    border-top: 1px solid var(--border);
    font-size: 13px;
}

tbody tr {
    transition: background .15s;
}

tbody tr:hover {
    background: rgba(255,255,255,.025);
}

/* FORMULARIOS */

form {
    max-width: 100%;
}

label {
    display: block;
    margin-bottom: 7px;
    color: #c4cfdd;
    font-size: 12px;
    font-weight: 600;
}

input:not([type="checkbox"]):not([type="radio"]),
select,
textarea {
    width: 100%;
    min-height: 43px;
    padding: 11px 13px;
    color: #edf3fa;
    background: #0c1420;
    border: 1px solid #29384a;
    border-radius: 8px;
    outline: none;
    transition: border-color .2s, box-shadow .2s;
}

textarea {
    min-height: 110px;
    resize: vertical;
}

input:focus, select:focus, textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(249,115,22,.11);
}

select option {
    color: white;
    background: #111b29;
}

.form-group, .field, .mb-3 {
    margin-bottom: 19px;
}

.helptext, .help-text {
    display: block;
    margin-top: 5px;
    color: var(--muted);
    font-size: 11px;
}

.errorlist, .error-message {
    padding-left: 16px;
    color: #fca5a5;
    font-size: 12px;
}

/* BOTONES */

.btn, button.btn, a.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 10px 16px;
    border: 1px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 700;
    transition: .2s;
}

.btn-primary {
    color: white !important;
    background: linear-gradient(135deg, #fb923c, #ea580c);
    box-shadow: 0 5px 15px rgba(249,115,22,.15);
}

.btn-primary:hover {
    background: var(--primary-hover);
    transform: translateY(-1px);
}

.btn-secondary {
    color: #cbd5e1 !important;
    background: #1b293a;
    border-color: var(--border) !important;
}

.btn-danger {
    color: white !important;
    background: #b91c1c;
}

.btn-success {
    color: white !important;
    background: #15803d;
}

/* ESTADOS Y NOTIFICACIONES */

.badge, .status-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 9px;
    color: #cbd5e1;
    background: #263548;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 700;
}

.notice, .alert {
    padding: 13px 16px;
    margin-bottom: 17px;
    color: #bfdbfe;
    background: rgba(56,189,248,.09);
    border: 1px solid rgba(56,189,248,.18);
    border-radius: 9px;
}

.alert-success {
    color: #bbf7d0;
    background: rgba(34,197,94,.09);
    border-color: rgba(34,197,94,.2);
}

.alert-danger, .alert-error {
    color: #fecaca;
    background: rgba(239,68,68,.09);
    border-color: rgba(239,68,68,.2);
}

/* ESTADOS VACIOS Y ACCIONES */

.empty-state {
    padding: 45px 20px;
    text-align: center;
    border: 1px dashed #334155;
    border-radius: var(--radius);
}

.empty-state-icon {
    margin-bottom: 12px;
    color: var(--primary);
    font-size: 36px;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
}

.pagination {
    display: flex;
    justify-content: center;
    gap: 7px;
    padding: 20px;
}

/* LOGIN */

.login-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 25px;
    background:
        radial-gradient(ellipse at 50% 10%, rgba(249,115,22,.13), transparent 50%),
        #090e17;
}

.login-card {
    width: min(100%, 440px);
    padding: 36px;
    background: #111b29;
    border: 1px solid var(--border);
    border-radius: 17px;
    box-shadow: 0 25px 90px rgba(0,0,0,.4);
}

.login-card h1 {
    font-size: 27px;
}

/* RESPONSIVE */

@media (max-width: 1100px) {
    .stat-grid, .stats-grid, .dashboard-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .page-content {
        padding: 25px 22px;
    }
}

@media (max-width: 760px) {
    :root {
        --sidebar-width: 0px;
    }

    .sidebar {
        position: relative;
        width: 100%;
        max-height: none;
        padding: 15px;
    }

    .sidebar .menu-label,
    .sidebar-bottom {
        display: none;
    }

    .sidebar .nav-link {
        display: inline-flex;
        width: auto;
    }

    .sidebar {
        display: block;
    }

    .brand {
        margin-bottom: 12px;
        padding-bottom: 13px;
    }

    .main-content {
        margin-left: 0;
    }

    .navbar {
        position: relative;
        min-height: 60px;
        padding: 12px 18px;
    }

    .page-content {
        padding: 22px 15px;
    }

    .stat-grid, .stats-grid, .dashboard-stats {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .stat-card {
        padding: 15px;
    }

    .stat-card .stat-value,
    .stat-card strong {
        font-size: 24px;
    }
}

@media (max-width: 420px) {
    .stat-grid, .stats-grid, .dashboard-stats {
        grid-template-columns: 1fr;
    }

    .page-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .login-card {
        padding: 25px 19px;
    }
}
