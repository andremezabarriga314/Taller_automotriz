/* Componentes reutilizables de MotorTech Service */

.page-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 26px;
}

.page-heading h1 {
    margin: 5px 0;
}

.page-heading p {
    margin: 0;
    opacity: .7;
}

.page-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    opacity: .65;
}

.empty-state {
    padding: 48px 24px;
    text-align: center;
    border: 1px dashed rgba(255,255,255,.15);
    border-radius: 14px;
}

.empty-state-icon {
    font-size: 34px;
    margin-bottom: 12px;
}

.empty-state p {
    opacity: .7;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 24px;
}
